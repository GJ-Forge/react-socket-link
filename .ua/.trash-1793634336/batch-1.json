   ],
   "complexity": "simple"
  },
  {
   "id": "file:src/core/LogicalConnection.ts",
   "type": "file",
   "name": "LogicalConnection.ts",
   "filePath": "src/core/LogicalConnection.ts",
   "summary": "Core logical connection implementation: a stable identity that owns retry policy, outgoing queue, message/state subscriptions and open-waiters while swapping replaceable WebSocketTransport instances underneath. Also defines the SocketView/SocketController interfaces and the createSocket factory.",
   "tags": [
    "service",
    "core",
    "state-machine",
    "reconnection",
    "websocket"
   ],
   "complexity": "complex",
   "languageNotes": "Uses a monotonically increasing generation counter plus queueMicrotask coalescing to ignore stale transport callbacks and avoid allocating sockets for superseded attempts; arrow-function class fields keep getSnapshot/subscribeState referentially stable for useSyncExternalStore."
  },
  {
   "id": "class:src/core/LogicalConnection.ts:LogicalConnection",
   "type": "class",
   "name": "LogicalConnection",
   "filePath": "src/core/LogicalConnection.ts",
   "lineRange": [
    29,
    290
   ],
   "summary": "Stateful connection controller implementing SocketController: manages connect/reconnect/update/close/dispose lifecycle, exponential-backoff retries, a bounded send queue flushed on open, typed per-message-type subscriptions, state listeners and whenOpen promises.",
   "tags": [
    "service",
    "state-machine",
    "reconnection",
    "pub-sub",
    "queue"
   ],
   "complexity": "complex"
  },
  {
