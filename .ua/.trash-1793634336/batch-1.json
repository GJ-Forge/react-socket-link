  {
   "id": "file:src/core/ConnectionDefinition.ts",
   "type": "file",
   "name": "ConnectionDefinition.ts",
   "filePath": "src/core/ConnectionDefinition.ts",
   "summary": "Declares the BaseMessage contract and the SocketDefinition identity/type token, plus defineSocket to create frozen, symbol-identified definitions that never open a socket.",
   "tags": [
    "type-definition",
    "factory",
    "protocol-typing",
    "core"
   ],
   "complexity": "simple",
   "languageNotes": "Uses an optional phantom function-typed property (__messages) to make Incoming/Outgoing generics invariant so distinct protocols cannot be interchanged."
  },
  {
   "id": "function:src/core/ConnectionDefinition.ts:defineSocket",
   "type": "function",
   "name": "defineSocket",
   "filePath": "src/core/ConnectionDefinition.ts",
   "lineRange": [
    13,
    18
   ],
   "summary": "Validates a non-empty name and returns a frozen SocketDefinition carrying a unique Symbol id typed with incoming/outgoing message generics.",
   "tags": [
    "factory",
    "validation",
    "type-token"
   ],
   "complexity": "simple"
  },
  {
   "id": "file:src/core/ConnectionState.ts",
   "type": "file",
   "name": "ConnectionState.ts",
   "filePath": "src/core/ConnectionState.ts",
   "summary": "Defines connection status and error-code union types, the SocketError and ConnectionSnapshot shapes, and a snapshot factory for immutable state objects.",
