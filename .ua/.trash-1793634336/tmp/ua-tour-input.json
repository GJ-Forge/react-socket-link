 "nodes": [
  {
   "id": "file:src/core/ConnectionDefinition.ts",
   "name": "ConnectionDefinition.ts",
   "filePath": "src/core/ConnectionDefinition.ts",
   "summary": "Declares the BaseMessage contract and the SocketDefinition identity/type token, plus defineSocket to create frozen, symbol-identified definitions that never open a socket.",
   "type": "file"
  },
  {
   "id": "file:src/core/ConnectionState.ts",
   "name": "ConnectionState.ts",
   "filePath": "src/core/ConnectionState.ts",
   "summary": "Defines connection status and error-code union types, the SocketError and ConnectionSnapshot shapes, and a snapshot factory for immutable state objects.",
   "type": "file"
  },
  {
   "id": "file:src/core/LogicalConnection.ts",
   "name": "LogicalConnection.ts",
   "filePath": "src/core/LogicalConnection.ts",
   "summary": "Core logical connection implementation: a stable identity that owns retry policy, outgoing queue, message/state subscriptions and open-waiters while swapping replaceable WebSocketTransport instances underneath. Also defines the SocketView/SocketController interfaces and the createSocket factory.",
   "type": "file"
  },
  {
   "id": "file:src/react/SocketProvider.tsx",
   "name": "SocketProvider.tsx",
   "filePath": "src/react/SocketProvider.tsx",
   "summary": "React context provider that eagerly creates a registry of LogicalConnections from socket registrations, connects them on mount, and disposes them on unmount in a Strict-Mode-safe way; also exposes registerSocket and useProviderSocket.",
   "type": "file"
  },
  {
   "id": "file:src/react/useGlobalSocket.ts",
   "name": "useGlobalSocket.ts",
   "filePath": "src/react/useGlobalSocket.ts",
   "summary": "Hook returning the read/send SocketView of a provider-registered global socket for a given definition.",
   "type": "file"
  },
  {
   "id": "file:src/react/useGlobalSocketController.ts",
   "name": "useGlobalSocketController.ts",
   "filePath": "src/react/useGlobalSocketController.ts",
   "summary": "Hook returning the full SocketController (connect/reconnect/update/close) for a provider-registered global socket.",
   "type": "file"
  },
  {
   "id": "file:src/react/useSocketEvent.ts",
   "name": "useSocketEvent.ts",
   "filePath": "src/react/useSocketEvent.ts",
   "summary": "Hook subscribing a handler to a typed message type (or wildcard) on a socket, keeping the latest handler in a ref to avoid resubscription.",
   "type": "file"
  },
  {
   "id": "file:src/react/useSocketSend.ts",
   "name": "useSocketSend.ts",
   "filePath": "src/react/useSocketSend.ts",
   "summary": "Hook producing a memoized send function bound to a socket.",
   "type": "file"
  },
  {
   "id": "file:src/react/useSocketState.ts",
   "name": "useSocketState.ts",
   "filePath": "src/react/useSocketState.ts",
   "summary": "Hook exposing a socket's ConnectionSnapshot to React via useSyncExternalStore.",
   "type": "file"
  },
  {
   "id": "file:src/core/index.ts",
   "name": "index.ts",
   "filePath": "src/core/index.ts",
   "summary": "React-free '/core' entry point barrel that re-exports socket definitions, the LogicalConnection/createSocket API, option and state types, and backoff helpers for standalone TypeScript use.",
   "type": "file"
  },
  {
   "id": "file:src/index.ts",
   "name": "index.ts",
   "filePath": "src/index.ts",
   "summary": "Main package entry point that re-exports the full public API: core connection primitives and types plus the React SocketProvider, registerSocket, and socket hooks.",
   "type": "file"
  },
  {
   "id": "file:tests/core.test.ts",
   "name": "core.test.ts",
   "filePath": "tests/core.test.ts",
   "summary": "Vitest suite for LogicalConnection behavior: identity preservation across transport replacement, update coalescing, reconnection/backoff, queue bounding and flushing, readiness waits, update validation with credential redaction, heartbeats, and codec rejection.",
   "type": "file"
  },
  {
   "id": "file:tests/helpers/MockWebSocket.ts",
   "name": "MockWebSocket.ts",
   "filePath": "tests/helpers/MockWebSocket.ts",
   "summary": "Test double for the browser WebSocket built on EventTarget, tracking created instances, sent payloads and close calls, with helpers to simulate open, message and abnormal close events.",
   "type": "file"
  },
  {
   "id": "file:tests/react.test.tsx",
   "name": "react.test.tsx",
   "filePath": "tests/react.test.tsx",
   "summary": "React integration tests verifying global sockets start without consumers and share one controller, local socket identity across re-renders and key changes, Strict Mode effect replay safety, and independent connections per hook owner.",
   "type": "file"
  },
  {
   "id": "file:tests/types.test.ts",
   "name": "types.test.ts",
   "filePath": "tests/types.test.ts",
   "summary": "Compile-time type tests using expectTypeOf and @ts-expect-error to ensure socket definitions bind incoming/outgoing message types, narrow subscribed events, and reject mismatched codecs or sends.",
   "type": "file"
  },
  {
   "id": "file:src/core/ConnectionOptions.ts",
   "name": "ConnectionOptions.ts",
   "filePath": "src/core/ConnectionOptions.ts",
   "summary": "Defines the typed socket configuration surface (SocketOptions, heartbeat/reconnect/queue options, MessageCodec, patch type) plus the default JSON codec and runtime validation/merging of options.",
   "type": "file"
  },
  {
   "id": "file:src/core/ReconnectionPolicy.ts",
   "name": "ReconnectionPolicy.ts",
   "filePath": "src/core/ReconnectionPolicy.ts",
   "summary": "Declares the BackoffStrategy type: a function mapping a one-based retry attempt to a delay in milliseconds.",
   "type": "file"
  },
  {
   "id": "file:src/core/WebSocketTransport.ts",
   "name": "WebSocketTransport.ts",
   "filePath": "src/core/WebSocketTransport.ts",
   "summary": "Wraps a single native WebSocket with an immutable handshake configuration, forwarding open/message/error/close events and managing heartbeat pings and silence timeouts; disposable so retired sockets never call back.",
   "type": "file"
  },
  {
   "id": "file:src/react/useLocalSocket.ts",
   "name": "useLocalSocket.ts",
   "filePath": "src/react/useLocalSocket.ts",
   "summary": "React hook that creates a component-scoped logical socket via createSocket, connecting on mount and closing/disposing on unmount with StrictMode-safe deferred disposal.",
   "type": "file"
  },
  {
   "id": "file:src/utils/Backoff.ts",
   "name": "Backoff.ts",
   "filePath": "src/utils/Backoff.ts",
   "summary": "Provides reconnection BackoffStrategy factories: exponential backoff with full jitter and a fixed-delay strategy.",
   "type": "file"
  },
  {
