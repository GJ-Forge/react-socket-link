   "filePath": "src/client/WebsocketClient.ts",
   "summary": "Framework-agnostic, generic WebSocket client handling connection lifecycle, backoff-based reconnects, heartbeats with dead-connection detection, type-keyed pub/sub dispatch, and an offline outbound message queue.",
   "type": "file"
  },
  {
   "id": "file:src/context/WebSocketProvider.tsx",
   "name": "WebSocketProvider.tsx",
   "filePath": "src/context/WebSocketProvider.tsx",
   "summary": "React context provider that lazily creates and caches named WebSocketClient instances from static connection configs or a resolve function, handling Strict Mode remounts and cleanup.",
   "type": "file"
  },
  {
